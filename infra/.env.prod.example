# Copy this to infra/.env.prod ON THE NAS ITSELF. Never commit the real file.

# --- image pinning (set by build-and-push.ps1 / update.sh) ---
IMAGE_TAG=latest

# Comma-separated, no protocol/port — the real public domain(s) the site is
# served under. Angular's SSR server rejects any request whose Host header
# isn't in this list and silently falls back to client-side rendering
# (empty shell, no SEO content) rather than erroring — so an unset or wrong
# value here breaks SSR for every real visit without any obvious failure.
# See context/features/seo-ssr-foundation-spec.md.
NG_ALLOWED_HOSTS=activswitzerland.com,www.activswitzerland.com

# --- where Mongo's data lives on the NAS (a real path, not a docker volume, so Hyper Backup covers it) ---
MONGO_DATA_PATH=/volume1/docker/activswitzerland/mongodb

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=<generate-a-new-strong-password>
MONGO_URI=mongodb://admin:<same-password-as-above>@mongodb:27017/activswitzerland?authSource=admin

NODE_ENV=production
PORT=3000

# generate fresh secrets for production — do not reuse the dev infra/.env values
JWT_SECRET=<generate-a-new-strong-random-string>
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

SMTP_HOST=smtp.mailgun.org
SMTP_PORT=2525
SMTP_EMAIL=postmaster@mail.mejo.ch
SMTP_PASSWORD=<same-as-dev-or-a-dedicated-prod-credential>
FROM_EMAIL=noreply@theoakcellar.com
FROM_NAME=TheOakCellar

# myswitzerland
MYS_ENDPOINT=https://opendata.myswitzerland.io
MYS_KEY=<same-as-dev-or-a-dedicated-prod-key>

# weather
MTO_ENDPOINT=https://api.open-meteo.com/v1/forecast

# opentransportdata.swiss (OJP — locations, connections)
OPENTRANSPORTDATA_ENDPOINT=https://api.opentransportdata.swiss/ojp20
TOKEN=<same-as-dev-or-a-dedicated-prod-token>

REDIS_HOST=redis
REDIS_PORT=6379
